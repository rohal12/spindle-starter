{
  "name": "spindle-starter",
  "version": "2.3.0",
  "description": "Modern Starter kit for Spindle",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "tsx .build/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "publish:pages": "node scripts/publish.mjs pages",
    "publish:itch": "node scripts/publish.mjs itch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "node scripts/setup.mjs",
    "lint": "spindle-lsp check \"src/story/**/*.{twee,tw}\"",
    "test": "vitest run",
    "ifid": "node scripts/ifid.mjs"
  },
  "keywords": [
    "twine",
    "spindle",
    "starter-kit",
    "twee-ts"
  ],
  "author": "Rohal12",
  "license": "Unlicense",
  "overrides": {
    "vitepress": {
      "vite": "^6.4.5"
    }
  },
  "devDependencies": {
    "@rohal12/spindle": "^0.64.7",
    "@rohal12/spindle-lsp": "^0.15.33",
    "@rohal12/twee-ts": "^2.0.0",
    "@types/archiver": "^8.0.0",
    "@types/browser-sync": "^2.29.1",
    "archiver": "^8.0.0",
    "browser-sync": "^3.0.4",
    "postcss": "^8.5.31",
    "postcss-csso": "^6.0.1",
    "postcss-preset-env": "^11.6.1",
    "postcss-selector-parser": "^7.1.7",
    "sass": "^1.105.2",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
